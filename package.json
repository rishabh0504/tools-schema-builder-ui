{
  "name": "@rishabh0504/tools-schema-builder-ui",
  "version": "0.1.0",
  "description": "Headless-ready, shadcn-compatible AI Tool & JSON Schema Visual Builder for OpenAI, Claude, Gemini, MCP, and Zod",
  "license": "MIT",
  "author": "Rishabh",
  "repository": {
    "type": "git",
    "url": "https://github.com/rishabh0504/tools-schema-builder-ui.git"
  },
  "bugs": {
    "url": "https://github.com/rishabh0504/tools-schema-builder-ui/issues"
  },
  "homepage": "https://github.com/rishabh0504/tools-schema-builder-ui#readme",
  "keywords": [
    "json-schema",
    "ai-tools",
    "function-calling",
    "openai",
    "claude",
    "gemini",
    "mcp",
    "model-context-protocol",
    "zod",
    "shadcn",
    "tailwind",
    "schema-builder"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.mjs",
      "require": "./dist/core.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.mjs",
      "require": "./dist/react.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:lib": "tsup",
    "prepublishOnly": "pnpm run build:lib",
    "lint": "eslint"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "^4",
    "tsup": "^8.5.1",
    "typescript": "^5"
  }
}